{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rychidesign/agencast/main/docs/spec/schema/skill.schema.json",
  "title": "Skill — YAML frontmatter of SKILL.md, format v1",
  "description": "See docs/spec/skill.md. name = directory name (checked by validate); the body must not be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
