{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rychidesign/agencast/main/docs/spec/schema/config.schema.json",
  "title": "config.yaml, format v1",
  "description": "See docs/spec/config.md. *_env fields contain the name of an environment variable, never its value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "openrouter",
    "models",
    "storage",
    "limits",
    "webhook",
    "callback"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "openrouter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_key_env"
      ],
      "properties": {
        "api_key_env": {
          "$ref": "#/$defs/env"
        },
        "base_url": {
          "type": "string",
          "pattern": "^(https://openrouter\\.ai/|http://(127\\.0\\.0\\.1|localhost)[:/])"
        },
        "jev_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/kebab"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*/[A-Za-z0-9._:-]+$"
          },
          "api": {
            "enum": ["chat", "images"]
          },
          "quality": {
            "enum": ["auto", "low", "medium", "high"]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "structured_output": {
            "enum": [
              "native_schema",
              "tool_wrapper",
              "prompt"
            ]
          }
        },
        "allOf": [
          {
            "if": {"required": ["quality"]},
            "then": {"required": ["api"], "properties": {"api": {"const": "images"}}}
          }
        ]
      }
    },
    "runs_dir": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "local",
            "r2"
          ]
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "public_base_url": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "r2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bucket",
            "account_id_env",
            "access_key_id_env",
            "secret_access_key_env",
            "public_base_url"
          ],
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "account_id_env": {
              "$ref": "#/$defs/env"
            },
            "access_key_id_env": {
              "$ref": "#/$defs/env"
            },
            "secret_access_key_env": {
              "$ref": "#/$defs/env"
            },
            "public_base_url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "local"
            ],
            "not": {
              "required": [
                "r2"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "r2"
              }
            }
          },
          "then": {
            "required": [
              "r2"
            ],
            "not": {
              "required": [
                "local"
              ]
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_budget_usd",
        "run_timeout"
      ],
      "properties": {
        "run_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run_image_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run_timeout": {
          "$ref": "#/$defs/duration"
        },
        "max_call_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_runs": {
          "type": "integer",
          "minimum": 1
        },
        "daily_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_env"
      ],
      "properties": {
        "token_env": {
          "$ref": "#/$defs/env"
        }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_env"
      ],
      "properties": {
        "secret_env": {
          "$ref": "#/$defs/env"
        }
      }
    }
  },
  "$defs": {
    "env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Name of an environment variable"
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(s|m|h)$"
    }
  }
}
